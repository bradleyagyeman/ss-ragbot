{
  "name": "ss-ragbot",
  "version": "1.0.0",
  "private": true,
  "description": "CLI-first canon-grounded RAG bot for Shadow Slave.",
  "type": "module",
  "bin": {
    "ss-ragbot": "./dist/interfaces/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/interfaces/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.18.0",
    "@xenova/transformers": "^2.17.2",
    "cheerio": "^1.1.2",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
